{
  "name": "pixelnoryx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev",
    "clean": "rm -rf .next node_modules/.cache",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",

    "lint": "next lint",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "prisma db push && prisma db seed",
    "neon:smoke": "node scripts/neon-smoke.mjs",
    "postinstall": "node scripts/prisma-generate.mjs",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "jest",
    "test:api": "jest --config jest.api.config.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neondatabase/serverless": "^1.2.1",
    "@next/third-parties": "^16.2.6",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^11.15.0",
    "jose": "^6.2.18",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
