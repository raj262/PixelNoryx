# Neon Postgres (pooled — app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres (direct — migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Neon Object Storage — filled by `neon login` then `neon deploy` / `neon env pull`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
